# Copy to .env.local and adjust for your environment.

# Required. Every route is served from this database. Until the cutover Phoenix
# shares it, and still receives the Abacate Pay webhook and expires stale orders.
# Note the scheme: `pg` needs postgres://, not the ecto:// Phoenix uses.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backend_dev

# Optional. `live` (default) talks to Abacate Pay and SMTP and needs every
# variable below; `fake` swaps in the in-process stand-ins the e2e suite uses
# (payments stay pending, mail lands in a logged outbox). Use `fake` for local
# development unless you are testing a real integration. Refused when
# NODE_ENV=production.
INTEGRATIONS=fake

# Required when INTEGRATIONS=live. Same values the Phoenix backend uses.
ABACATE_PAY_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=tickets@example.com

# Required from the cutover on; unused before it. The per-seller secret Abacate
# Pay appends to the webhook URL (`/webhooks/abacate-pay?webhookSecret=...`),
# the same value Phoenix uses. While it is unset every delivery is refused.
ABACATE_PAY_WEBHOOK_SECRET=

# Leave `off` (default) while Phoenix runs: its ExpiryWorker sweeps the same
# orders and two sweepers can release one order's stock twice. Set to `on` in
# the deploy that stops Phoenix, or stale orders hold their stock forever.
# `on` needs ORIGIN (the site's public URL), for the links in recovery emails.
ORDER_RECONCILER=off
ORIGIN=https://tickets.example.com

# Optional. Login code requests allowed per address per minute (default 5).
AUTH_CODE_RATE_LIMIT=5

# Optional. Guesses allowed per email while one login code is alive (default 5).
AUTH_VERIFY_ATTEMPT_LIMIT=5

# Required behind a reverse proxy (Traefik, Dokploy): without them every visitor
# shares the proxy's address and one person can exhaust the login limits for all.
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1
