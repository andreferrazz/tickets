# Copy to .env.local and adjust for your environment.

# Required. Points at the Phoenix backend.
PUBLIC_API_URL=http://localhost:4000/api/v1

# Required. The SvelteKit server reads the same database Phoenix does, for the
# routes whose backend has already moved here (currently the home page).
# Note the scheme: `pg` needs postgres://, not the ecto:// Phoenix uses.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backend_dev
