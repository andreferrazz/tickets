#!/usr/bin/env bash
#
# ai-commit — Stage all changes and commit with an AI-generated message.
#
# Requirements: claude, jq, git
#
set -euo pipefail

# ---------- defaults ----------
MODEL="sonnet"
ASSUME_YES=false
STYLE="conventional"   # conventional | plain
SCOPE=""               # optional scope for conventional commits (e.g. "api")
EDIT=false             # open $EDITOR to tweak message before committing

# ---------- helpers ----------
c_red()   { printf "\033[31m%s\033[0m\n" "$*"; }
c_green() { printf "\033[32m%s\033[0m\n" "$*"; }
c_blue()  { printf "\033[34m%s\033[0m\n" "$*"; }
c_dim()   { printf "\033[2m%s\033[0m\n" "$*"; }

die() { c_red "❌ $*"; exit 1; }

usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

Options:
  -m, --model <model>     Claude model (default: sonnet)
  -s, --style <style>     Message style: conventional|plain (default: conventional)
      --scope <scope>     Conventional commit scope, e.g. "api"
  -e, --edit              Open \$EDITOR to tweak the message before committing
  -y, --yes               Skip confirmation prompt
  -h, --help              Show this help

Examples:
  ./ai-commit
  ./ai-commit --scope api --yes
  ./ai-commit --style plain --edit
EOF
}

# ---------- parse args ----------
while [[ $# -gt 0 ]]; do
  case "$1" in
    -m|--model)   MODEL="$2"; shift 2 ;;
    -s|--style)   STYLE="$2"; shift 2 ;;
    --scope)      SCOPE="$2"; shift 2 ;;
    -e|--edit)    EDIT=true; shift ;;
    -y|--yes)     ASSUME_YES=true; shift ;;
    -h|--help)    usage; exit 0 ;;
    *)            die "Unknown option: $1" ;;
  esac
done

# ---------- preflight ----------
command -v claude >/dev/null || die "claude CLI not found"
command -v jq     >/dev/null || die "jq not found"
command -v git    >/dev/null || die "git not found"

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "Not a git repo"

# Anything to commit?
if git diff --quiet && git diff --cached --quiet && [[ -z "$(git ls-files --others --exclude-standard)" ]]; then
  die "Nothing to commit — working tree clean."
fi

# ---------- 1. Stage everything ----------
c_blue "📦 Staging all changes (git add .)…"
git add -A

# ---------- 2. Show staged files ----------
STAGED_FILES=$(git diff --cached --name-status)
[[ -z "$STAGED_FILES" ]] && die "No staged changes after 'git add .'."

c_dim "----- Staged files -----"
echo "$STAGED_FILES" | while IFS=$'\t' read -r status path rest; do
  case "$status" in
    A*)  c_green "  + $path" ;;          # added
    M*)  printf "    ~ %s\n" "$path" ;;  # modified
    D*)  c_red "  - $path" ;;            # deleted
    R*)  printf "    → %s\n" "$path $rest" ;; # renamed
    *)   printf "    ? %s %s\n" "$status" "$path" ;;
  esac
done
c_dim "------------------------"
echo

# ---------- 3. Build prompt ----------
DIFF=$(git diff --cached)
FILE_LIST=$(git diff --cached --name-only)

if [[ "$STYLE" == "conventional" ]]; then
  SCOPE_HINT=""
  [[ -n "$SCOPE" ]] && SCOPE_HINT="Use scope: \"$SCOPE\"."
  STYLE_RULES=$(cat <<EOF
Write a Conventional Commits message:
  <type>(<scope>): <subject>

  <body>

Rules:
- type: one of feat, fix, refactor, docs, test, chore, perf, style, build, ci
- subject: imperative mood, lowercase, no period, <=72 chars
- $SCOPE_HINT
- body: optional, wrap at ~72 chars, explain *why* (not *what*) when useful
- omit body for trivial changes
EOF
)
else
  STYLE_RULES=$(cat <<'EOF'
Write a plain commit message:
- First line: short subject, imperative mood, <=72 chars, no period
- Optional body separated by a blank line, wrap at ~72 chars
EOF
)
fi

PROMPT=$(cat <<EOF
You are writing a git commit message for the staged changes below.

$STYLE_RULES

Return a JSON object with EXACTLY this shape:
  { "message": "<​full commit message including subject and optional body>" }

Return ONLY the JSON, no code fences, no commentary.

--- FILES CHANGED ---
$FILE_LIST

--- DIFF ---
$DIFF
EOF
)

# ---------- 4. Generate message ----------
c_blue "🤖 Generating commit message…"

RAW=$(printf "%s" "$PROMPT" | claude -p --model "$MODEL" --output-format json | jq -r '.result')
RAW=$(echo "$RAW" | sed -E 's/^```(json)?//; s/```$//')

MESSAGE=$(echo "$RAW" | jq -r '.message' 2>/dev/null) || die "Failed to parse message JSON"
[[ -z "$MESSAGE" || "$MESSAGE" == "null" ]] && die "Empty message from Claude"

c_dim "----- Commit message -----"
echo "$MESSAGE"
c_dim "--------------------------"
echo

# ---------- 5. Optional edit ----------
if $EDIT; then
  TMP=$(mktemp)
  echo "$MESSAGE" > "$TMP"
  "${EDITOR:-vi}" "$TMP"
  MESSAGE=$(cat "$TMP")
  rm -f "$TMP"
  [[ -z "$MESSAGE" ]] && die "Empty message after edit — aborting."
fi

# ---------- 6. Confirm ----------
if ! $ASSUME_YES; then
  read -r -p "Commit with this message? [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]] || { c_dim "Staged changes left in place."; exit 0; }
fi

# ---------- 7. Commit ----------
# Use -F to preserve newlines exactly
TMP_MSG=$(mktemp)
printf "%s\n" "$MESSAGE" > "$TMP_MSG"
git commit -F "$TMP_MSG"
rm -f "$TMP_MSG"

c_green "✅ Committed."
git --no-pager log -1 --oneline
