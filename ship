#!/usr/bin/env bash
#
# ship-pr.sh — Draft, review, and merge a PR with help from Claude Code.
#
# Requirements: gh (authenticated), claude, jq, git
#
set -euo pipefail

# ---------- defaults ----------
BASE="main"
MERGE_STRATEGY="squash"        # squash | merge | rebase
MODEL="sonnet"
ASSUME_YES=false
SKIP_AI_REVIEW=true
DRAFT=false
DELETE_BRANCH=false
AUTO_MERGE=false               # use gh's --auto (waits for checks)

# ---------- helpers ----------
c_red()   { printf "\033[31m%s\033[0m\n" "$*"; }
c_green() { printf "\033[32m%s\033[0m\n" "$*"; }
c_blue()  { printf "\033[34m%s\033[0m\n" "$*"; }
c_dim()   { printf "\033[2m%s\033[0m\n" "$*"; }

die() { c_red "❌ $*"; exit 1; }

usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

Options:
  -b, --base <branch>        Base branch (default: main)
  -s, --strategy <strat>     Merge strategy: squash|merge|rebase (default: squash)
  -m, --model <model>        Claude model (default: sonnet)
  -y, --yes                  Skip human confirmation prompts
      --review               Run the AI review step (skipped by default)
      --draft                Open PR as draft (implies no merge)
      --delete-branch        Delete the branch after merge (kept by default)
      --auto                 Use 'gh pr merge --auto' (waits for checks)
  -h, --help                 Show this help

Examples:
  ./ship-pr.sh
  ./ship-pr.sh -b develop -s rebase
  ./ship-pr.sh --yes --auto
EOF
}

# ---------- parse args ----------
while [[ $# -gt 0 ]]; do
  case "$1" in
    -b|--base)        BASE="$2"; shift 2 ;;
    -s|--strategy)    MERGE_STRATEGY="$2"; shift 2 ;;
    -m|--model)       MODEL="$2"; shift 2 ;;
    -y|--yes)         ASSUME_YES=true; shift ;;
    --review)         SKIP_AI_REVIEW=false; shift ;;
    --draft)          DRAFT=true; shift ;;
    --delete-branch)  DELETE_BRANCH=true; shift ;;
    --auto)           AUTO_MERGE=true; shift ;;
    -h|--help)        usage; exit 0 ;;
    *)                die "Unknown option: $1" ;;
  esac
done

# ---------- preflight ----------
command -v gh     >/dev/null || die "gh CLI not found"
command -v claude >/dev/null || die "claude CLI not found"
command -v jq     >/dev/null || die "jq not found"
command -v git    >/dev/null || die "git not found"

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "Not a git repo"

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
[[ "$CURRENT_BRANCH" == "$BASE" ]] && die "You're on the base branch ($BASE). Switch to a feature branch first."

# Ensure we have latest base for accurate diff
c_dim "Fetching origin/$BASE…"
git fetch origin "$BASE" --quiet || die "Could not fetch origin/$BASE"

# Make sure branch is pushed
if ! git ls-remote --exit-code --heads origin "$CURRENT_BRANCH" >/dev/null 2>&1; then
  c_blue "Pushing $CURRENT_BRANCH to origin…"
  git push -u origin "$CURRENT_BRANCH"
fi

# ---------- gather diff ----------
DIFF=$(git diff "origin/$BASE...HEAD")
[[ -z "$DIFF" ]] && die "No diff against origin/$BASE. Nothing to ship."

COMMIT_LOG=$(git log "origin/$BASE..HEAD" --pretty=format:"- %s")

# ---------- 1. Draft PR title + body with Claude ----------
c_blue "🤖 Drafting PR title & body…"

DRAFT_PROMPT=$(cat <<'EOF'
You are drafting a GitHub pull request. Based on the commit log and diff below,
produce a JSON object with EXACTLY these keys:

  "title": a concise, conventional-commit-style PR title (<=72 chars)
  "body":  a markdown PR description with sections:
            ## Summary
            ## Changes (bullet list)
            ## Testing (how to verify; "N/A" if unclear)

Return ONLY the JSON object, no code fences, no commentary.

--- COMMITS ---
EOF
)

PROMPT_INPUT="$DRAFT_PROMPT
$COMMIT_LOG

--- DIFF ---
$DIFF"

META_JSON=$(printf "%s" "$PROMPT_INPUT" | claude -p --model "$MODEL" --output-format json \
  | jq -r '.result')

# Strip accidental code fences if any
META_JSON=$(echo "$META_JSON" | sed -E 's/^```(json)?//; s/```$//')
echo $META_JSON
TITLE=$(echo "$META_JSON" | jq -r '.title' 2>/dev/null) || die "Failed to parse title"
BODY=$(echo "$META_JSON"  | jq -r '.body'  2>/dev/null) || die "Failed to parse body"

[[ -z "$TITLE" || "$TITLE" == "null" ]] && die "Empty PR title from Claude"
[[ -z "$BODY"  || "$BODY"  == "null" ]] && die "Empty PR body from Claude"

c_green "Title: $TITLE"
echo
c_dim "----- Body -----"
echo "$BODY"
c_dim "----------------"
echo

if ! $ASSUME_YES; then
  read -r -p "Open PR with this title/body? [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]] || die "Aborted by user."
fi

# ---------- 2. Open PR ----------
c_blue "📬 Opening PR…"
PR_ARGS=(--base "$BASE" --head "$CURRENT_BRANCH" --title "$TITLE" --body "$BODY")
$DRAFT && PR_ARGS+=(--draft)

PR_URL=$(gh pr create "${PR_ARGS[@]}")
c_green "Opened: $PR_URL"

if $DRAFT; then
  c_blue "Draft PR opened — stopping here (no merge for drafts)."
  exit 0
fi

# ---------- 3. AI review ----------
if ! $SKIP_AI_REVIEW; then
  c_blue "🔍 Asking Claude to review the PR…"

  REVIEW_PROMPT=$(cat <<'EOF'
You are reviewing a GitHub pull request for safety and quality before merge.

On the FIRST line, output exactly one of:
  APPROVE   — safe to merge, no blocking issues
  BLOCK     — there are blocking issues

After that line, provide a brief markdown review with:
  - Notable concerns (bugs, security, perf, breaking changes)
  - Suggestions (non-blocking)

Be strict about: secrets/keys, deleted tests, broken types, obvious bugs.
Be lenient about: style nits, minor naming.

--- PR DIFF ---
EOF
)

  PR_DIFF=$(gh pr diff "$PR_URL")
  REVIEW=$(printf "%s\n%s" "$REVIEW_PROMPT" "$PR_DIFF" \
    | claude -p --model "$MODEL")

  echo
  c_dim "----- Review -----"
  echo "$REVIEW"
  c_dim "------------------"
  echo

  VERDICT=$(echo "$REVIEW" | head -n1 | tr -d '[:space:]')

  if [[ "$VERDICT" != "APPROVE" ]]; then
    c_red "Review verdict: $VERDICT — not merging."
    c_dim "PR left open at: $PR_URL"
    exit 1
  fi
  c_green "Review verdict: APPROVE"
fi

# ---------- 4. Human gate ----------
if ! $ASSUME_YES; then
  read -r -p "Merge PR now with strategy '$MERGE_STRATEGY'? [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]] || { c_dim "PR left open at: $PR_URL"; exit 0; }
fi

# ---------- 5. Merge ----------
c_blue "🚀 Merging…"
MERGE_ARGS=("--$MERGE_STRATEGY")
$DELETE_BRANCH && MERGE_ARGS+=(--delete-branch)
$AUTO_MERGE    && MERGE_ARGS+=(--auto)

gh pr merge "$PR_URL" "${MERGE_ARGS[@]}"
c_green "✅ Done: $PR_URL"

